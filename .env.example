# Copia este archivo como .env y ajusta los valores (nunca subas .env a GitHub).

NOMBRE_EMPRESA=UñasBellas

# --- Base de datos ---
POSTGRES_USER=soporte
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=incidencias

# --- Servicio LLM (actor externo) ---
# Opciones: openai | anthropic | google_genai | mock
# "mock" funciona sin API key (respuestas simuladas) para probar el flujo completo.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_TIMEOUT_S=30
# Contingencia R2 (opcional): modelo alternativo si el principal falla
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- RAG ---
RAG_UMBRAL_SIMILITUD=0.45
RAG_TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- CP2 / R4: confianza mínima; bajo este valor el ticket se escala ---
UMBRAL_CONFIANZA_CLASIFICACION=0.5

# --- Línea base del proceso manual (para KPIs) ---
MINUTOS_TICKET_MANUAL=15
MINUTOS_RESPUESTA_MANUAL=30

# --- Seguridad básica ---
SECRET_KEY=genera-una-clave-larga-y-aleatoria
ADMIN_EMAIL=admin@pyme.cl
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador Técnico

# --- R10: límite de consultas por minuto por IP ---
RATE_LIMIT_POR_MINUTO=20
